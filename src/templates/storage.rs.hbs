use crate::types::{Block, BlockHeader, Hash};
use std::collections::HashMap;
use std::fs::{self, File, OpenOptions};
use std::io::{self, Read, Seek, SeekFrom, Write};
use std::path::{Path, PathBuf};

pub const PRUNE_DEPTH: u64 = {{consensus.prune_depth_blocks}};

pub struct BlockStorage {
    data_dir: PathBuf,
    index: HashMap<Hash, (u64, u64)>,
    tip_hash: Hash,
    tip_height: u64,
}

impl BlockStorage {
    pub fn open(data_dir: &Path) -> io::Result<Self> {
        fs::create_dir_all(data_dir)?;
        let mut storage = Self {
            data_dir: data_dir.to_path_buf(),
            index: HashMap::new(),
            tip_hash: [0u8; 32],
            tip_height: 0,
        };
        storage.load_or_rebuild()?;
        Ok(storage)
    }

    pub fn tip(&self) -> (Hash, u64) {
        (self.tip_hash, self.tip_height)
    }

    pub fn get_block(&self, hash: &Hash) -> Option<Block> {
        let &(height, offset) = self.index.get(hash)?;
        self.read_block_at(offset, height).ok()
    }

    pub fn get_header(&self, hash: &Hash) -> Option<BlockHeader> {
        self.get_block(hash).map(|b| b.header)
    }

    pub fn get_block_by_height(&self, height: u64) -> Option<Block> {
        let hash = self.index.iter().find(|(_, (h, _))| *h == height)?.0;
        self.get_block(hash)
    }

    pub fn store_block(&mut self, block: &Block, height: u64) -> io::Result<()> {
        let hash = block.hash();
        let offset = self.append_block(block)?;
        self.index.insert(hash, (height, offset));
        self.tip_hash = hash;
        self.tip_height = height;
        self.save_meta()?;
        self.save_index()?;
        Ok(())
    }

    pub fn has_block(&self, hash: &Hash) -> bool {
        self.index.contains_key(hash)
    }

    pub fn height_of(&self, hash: &Hash) -> Option<u64> {
        self.index.get(hash).map(|(h, _)| *h)
    }

    fn load_or_rebuild(&mut self) -> io::Result<()> {
        let meta_path = self.data_dir.join("meta.bin");
        let index_path = self.data_dir.join("index.bin");

        if meta_path.exists() && index_path.exists() {
            let mut meta_file = File::open(&meta_path)?;
            let mut tip_hash = [0u8; 32];
            meta_file.read_exact(&mut tip_hash)?;
            let mut tip_height_bytes = [0u8; 8];
            meta_file.read_exact(&mut tip_height_bytes)?;
            self.tip_hash = tip_hash;
            self.tip_height = u64::from_le_bytes(tip_height_bytes);

            let mut index_file = File::open(&index_path)?;
            let mut index_data = Vec::new();
            index_file.read_to_end(&mut index_data)?;
            let mut offset = 0;
            while offset + 40 <= index_data.len() {
                let mut hash = [0u8; 32];
                hash.copy_from_slice(&index_data[offset..offset + 32]);
                let height = u64::from_le_bytes([
                    index_data[offset + 32],
                    index_data[offset + 33],
                    index_data[offset + 34],
                    index_data[offset + 35],
                    index_data[offset + 36],
                    index_data[offset + 37],
                    index_data[offset + 38],
                    index_data[offset + 39],
                ]);
                let file_offset = u64::from_le_bytes([
                    index_data[offset + 40],
                    index_data[offset + 41],
                    index_data[offset + 42],
                    index_data[offset + 43],
                    index_data[offset + 44],
                    index_data[offset + 45],
                    index_data[offset + 46],
                    index_data[offset + 47],
                ]);
                self.index.insert(hash, (height, file_offset));
                offset += 48;
            }
        }

        Ok(())
    }

    fn append_block(&self, block: &Block) -> io::Result<u64> {
        let path = self.data_dir.join("chain.bin");
        let mut file = OpenOptions::new()
            .create(true)
            .append(true)
            .open(&path)?;
        let offset = file.seek(SeekFrom::End(0))?;
        let bytes = postcard::to_stdvec(block).expect("serialize block");
        let len = bytes.len() as u64;
        file.write_all(&len.to_le_bytes())?;
        file.write_all(&bytes)?;
        Ok(offset)
    }

    fn read_block_at(&self, offset: u64, _height: u64) -> io::Result<Block> {
        let path = self.data_dir.join("chain.bin");
        let mut file = File::open(&path)?;
        file.seek(SeekFrom::Start(offset))?;
        let mut len_bytes = [0u8; 8];
        file.read_exact(&mut len_bytes)?;
        let len = u64::from_le_bytes(len_bytes) as usize;
        let mut bytes = vec![0u8; len];
        file.read_exact(&mut bytes)?;
        let block: Block = postcard::from_bytes(&bytes).map_err(|e| {
            io::Error::new(io::ErrorKind::InvalidData, e.to_string())
        })?;
        Ok(block)
    }

    fn save_meta(&self) -> io::Result<()> {
        let path = self.data_dir.join("meta.bin");
        let mut file = File::create(&path)?;
        file.write_all(&self.tip_hash)?;
        file.write_all(&self.tip_height.to_le_bytes())?;
        Ok(())
    }

    fn save_index(&self) -> io::Result<()> {
        let path = self.data_dir.join("index.bin");
        let mut file = File::create(&path)?;
        for (hash, (height, offset)) in &self.index {
            file.write_all(hash)?;
            file.write_all(&height.to_le_bytes())?;
            file.write_all(&offset.to_le_bytes())?;
        }
        Ok(())
    }

    pub fn prune(&self) -> io::Result<()> {
        Ok(())
    }
}
